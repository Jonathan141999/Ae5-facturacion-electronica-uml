@startuml
skinparam backgroundColor #FFFDF7
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor #8B5E34
  ActorBorderColor #8B5E34
  LifeLineBorderColor #8B5E34
  ParticipantBorderColor #8B5E34
  ParticipantBackgroundColor #FFF3E0
  ActorBackgroundColor #FFF3E0
}

participant "factura: Factura" as F
participant "comprobante: ComprobanteElectronico" as CE
participant "SRI" as SRI
actor Contador as CT

F -> CE : generarComprobanteXML()
activate CE
CE -> CE : construirXML()
CE -> SRI : enviarComprobanteXML(xml)
activate SRI
SRI --> CE : respuesta(autorizacion / rechazo)
deactivate SRI

alt comprobante autorizado
    CE -> F : registrarEstadoSRI("autorizada")
    activate F
    F --> CE : ok
    deactivate F
else comprobante rechazado
    CE -> CT : notificarRechazo(motivo)
    activate CT
    CT --> CE : ok
    deactivate CT
end

deactivate CE
@enduml